.venv/
__pycache__/
*.egg-info/
.DS_Store

# Source downloads are large and rebuilt by `python -m fcast.build_geo`.
/data/raw/
# The boundaries GeoPackage is ~75 MB; the CSV and metadata are small enough to track.
/data/processed/*.gpkg

# Model runs (fits, samples, plots) are regenerated by scripts/run_bdbv.R.
/output/
# Compiled Stan models.
/stan/*
!/stan/*.stan
/scratch_out/
